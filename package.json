{
  "name": "atlas-of-olympians",
  "private": true,
  "version": "0.1.0",
  "description": "Atlas of Olympians: an Olympics dashboard 1896–2026 (static Vite + TypeScript + Material Web + ECharts)",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "data": "python3 scripts/build_data.py"
  },
  "dependencies": {
    "@material/web": "^2.5.0",
    "echarts": "^6.1.0",
    "gsap": "^3.15.1"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "^0.49.0",
    "typescript": "~5.9",
    "vite": "^7.3.8"
  }
}
